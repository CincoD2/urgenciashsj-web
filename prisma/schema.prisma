generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum ChangelogReactionType {
  LIKE
  DISLIKE
  IMPROVABLE
}

model User {
  id            String    @id @default(cuid())
  name          String?
  hospital      String?
  position      String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  approved      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
}

model ChangelogReaction {
  id        String                @id @default(cuid())
  entryId   String
  visitorId String
  reaction  ChangelogReactionType
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@unique([entryId, visitorId])
  @@index([entryId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppSettings {
  id             Int      @id @default(1)
  idleMinutes    Int      @default(5)
  warningSeconds Int      @default(30)
  updatedAt      DateTime @updatedAt
}

model BrokenLinkHit {
  id        String   @id @default(cuid())
  path      String
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}

model ExternalLinkCheck {
  id         String   @id @default(cuid())
  sourcePath String?
  targetUrl  String
  finalUrl   String?
  statusCode Int?
  isError    Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([isError, createdAt])
}
